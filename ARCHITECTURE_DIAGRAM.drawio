# 🏗️ 현재 시스템 아키텍처

## 📊 전체 아키텍처

```mermaid
graph TB
    subgraph "외부 사용자"
        User[👤 사용자<br/>브라우저/앱]
    end

    subgraph "AWS Cloud"
        subgraph "Networking"
            ALB[⚖️ AWS Application<br/>Load Balancer]
            K8S_SVC[🔄 Kubernetes Service<br/>LoadBalancer<br/>Port: 80:8080]
        end

        subgraph "EKS Cluster - chat-system namespace"
            subgraph "Configuration"
                CM[📝 ConfigMap<br/>chat-config<br/>- DB_HOST<br/>- REDIS_HOST<br/>- SECURITY_MODE]
                SECRET[🔐 Secret<br/>chat-secret<br/>- DB_PASSWORD<br/>- JWT_SECRET<br/>- AWS_KEYS]
            end

            subgraph "Kubernetes Resources"
                HPA[📈 HPA<br/>Min: 3, Max: 10<br/>CPU Target: 70%]
                PDB[🛡️ PDB<br/>minAvailable: 2]
            end

            subgraph "Application Pods"
                POD1[🐳 Pod 1<br/>chat-service<br/>CPU: 100m-500m<br/>MEM: 256Mi-512Mi]
                POD2[🐳 Pod 2<br/>chat-service<br/>CPU: 100m-500m<br/>MEM: 256Mi-512Mi]
                POD3[🐳 Pod 3<br/>chat-service<br/>CPU: 100m-500m<br/>MEM: 256Mi-512Mi]
            end

            HPA -.-> POD1
            HPA -.-> POD2
            HPA -.-> POD3
            PDB -.-> POD1
            PDB -.-> POD2
            PDB -.-> POD3
            CM -.-> POD1
            CM -.-> POD2
            CM -.-> POD3
            SECRET -.-> POD1
            SECRET -.-> POD2
            SECRET -.-> POD3
        end

        subgraph "External EC2 Instance<br/>54.116.26.182"
            MYSQL[(🗄️ MySQL 8.0<br/>Port: 3306<br/>Database: coreconnect<br/>max_connections: 300)]
            REDIS[(⚡ Redis 7<br/>Port: 6379<br/>Cache & Pub/Sub)]
        end
    end

    User -->|HTTP/HTTPS| ALB
    ALB -->|Traffic| K8S_SVC
    K8S_SVC -->|Load Balance| POD1
    K8S_SVC -->|Load Balance| POD2
    K8S_SVC -->|Load Balance| POD3
    
    POD1 -->|HikariCP<br/>Pool: 10| MYSQL
    POD2 -->|HikariCP<br/>Pool: 10| MYSQL
    POD3 -->|HikariCP<br/>Pool: 10| MYSQL
    
    POD1 -->|Cache/Session| REDIS
    POD2 -->|Cache/Session| REDIS
    POD3 -->|Cache/Session| REDIS

    style User fill:#e1f5ff
    style ALB fill:#ff9800
    style K8S_SVC fill:#4caf50
    style POD1 fill:#2196f3
    style POD2 fill:#2196f3
    style POD3 fill:#2196f3
    style MYSQL fill:#00897b
    style REDIS fill:#d32f2f
    style HPA fill:#9c27b0
    style PDB fill:#9c27b0
    style CM fill:#ffc107
    style SECRET fill:#f44336
```

