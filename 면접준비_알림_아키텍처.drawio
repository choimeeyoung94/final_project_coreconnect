          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- 5. WebSocket 전송 -->
        <mxCell id="step5" value="5. WebSocket으로 알림 전송&#xa;WebSocketDeliveryService&#xa;/topic/notification/{userId}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
