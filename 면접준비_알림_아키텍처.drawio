        <!-- Backend Event Trigger -->
        <mxCell id="backend-label" value="Backend (이벤트 발생)" style="text;html=1;strokeColor=none;fillColor=#ffe6cc;align=center;verticalAlign=middle;fontSize=16;fontStyle=1" vertex="1" parent="1">
