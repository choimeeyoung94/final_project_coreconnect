        </mxCell>

        <!-- 3. 이벤트 발생 (예: 새 이메일) -->
        <mxCell id="step3" value="3. 알림 이벤트 발생&#xa;• 새 이메일 도착&#xa;• 새 채팅 메시지&#xa;• 게시글 댓글 등" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="130" width="250" height="80" as="geometry"/>
        </mxCell>

        <!-- 4. NotificationService 호출 -->
        <mxCell id="step4" value="4. NotificationService.sendNotification()&#xa;• 알림 DB 저장 (notification 테이블)&#xa;• 알림 타입, 메시지, 수신자 등" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="550" y="230" width="250" height="80" as="geometry"/>
        </mxCell>

        <!-- Arrow 3 to 4 -->
        <mxCell id="arrow3-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fillColor=#ffe6cc;strokeColor=#d79b00;" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Database -->
