        <!-- 1. 사용자 로그인/페이지 접속 -->
        <mxCell id="step1" value="1. 사용자 로그인/접속&#xa;(App.jsx, AuthContext)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="130" width="200" height="60" as="geometry"/>
        </mxCell>

        <!-- 2. 알림 WebSocket 연결 -->
        <mxCell id="step2" value="2. 알림 WebSocket 연결&#xa;connectNotification()&#xa;/ws/notification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="210" width="200" height="70" as="geometry"/>
        </mxCell>

        <!-- Arrow 1 to 2 -->
        <mxCell id="arrow1-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;fillColor=#dae8fc;strokeColor=#6c8ebf;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry"/>
