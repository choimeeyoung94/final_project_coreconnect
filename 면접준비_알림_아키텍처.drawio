        </mxCell>

        <!-- 기술 스택 -->
        <mxCell id="tech-stack" value="기술 스택&#xa;• Frontend: React, STOMP.js, Context API&#xa;• Backend: Spring Boot, Spring WebSocket&#xa;• Database: MySQL (notification 테이블)&#xa;• Protocol: WebSocket, STOMP" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;fontSize=12;fontStyle=0;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="850" y="330" width="280" height="120" as="geometry"/>
        </mxCell>

        <!-- 알림 타입 -->
        <mxCell id="notification-types" value="알림 타입&#xa;• EMAIL: 새 이메일 도착&#xa;• CHAT: 새 채팅 메시지&#xa;• BOARD: 게시글 댓글/좋아요&#xa;• SCHEDULE: 일정 알림&#xa;• ATTENDANCE: 근태 알림&#xa;• LEAVE: 휴가 승인/거절" style="text;html=1;strokeColor=#d79b00;fillColor=#ffe6cc;align=left;verticalAlign=top;fontSize=12;fontStyle=0" vertex="1" parent="1">
